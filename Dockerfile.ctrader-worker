FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY pyproject.toml README.md ./
COPY src ./src

RUN python -m pip install --no-cache-dir --timeout 120 --retries 5 ".[ctrader]" \
    && groupadd --system --gid 10001 ctrader \
    && useradd --system --uid 10001 --gid 10001 --no-create-home --shell /usr/sbin/nologin ctrader \
    && install -d -m 700 -o 10001 -g 10001 /var/lib/ctrader

USER 10001:10001

ENV CTRADER_CREDENTIAL_BACKEND=encrypted-file \
    CTRADER_CREDENTIAL_FILE=/var/lib/ctrader/credentials.enc \
    CTRADER_CREDENTIAL_KEY_FILE=/run/secrets/ctrader_credential_key \
    DATABASE_URL_FILE=/run/secrets/ctrader_worker_database_url

VOLUME ["/var/lib/ctrader"]

# The supervisor forwards termination and gives the worker 80s of Compose's 90s grace.
STOPSIGNAL SIGTERM
HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=1 \
    CMD ["python", "-m", "trading.ctrader.worker_supervisor", "--healthcheck"]
ENTRYPOINT ["python", "-m", "trading.ctrader.worker_supervisor"]
